# FloorGen Production Configuration Template

# Server settings
FLOORGEN_HOST=0.0.0.0
FLOORGEN_PORT=8000
FLOORGEN_WORKERS=1
FLOORGEN_LOG_LEVEL=INFO
FLOORGEN_LOG_FORMAT=standard

# Hardware & Engine
FLOORGEN_DEVICE=cuda
FLOORGEN_HIDDEN_DIM=256
FLOORGEN_NUM_LAYERS=4
FLOORGEN_CHECKPOINT=checkpoints/rag_diffusion.pt

# Data Paths
FLOORGEN_DATA_DIR=data/processed
FLOORGEN_RAW_DIR=data/raw

# Inference Defaults
FLOORGEN_SAMPLING=ddim
FLOORGEN_STEPS=20
FLOORGEN_BATCH=1
FLOORGEN_TOP_K=5
FLOORGEN_LAMBDA_MULT=0.65
FLOORGEN_ENABLE_CACHE=true
FLOORGEN_ENABLE_SOLVER=true
FLOORGEN_SOLVER_TIME_LIMIT=2.0
FLOORGEN_PIXELS_PER_METER=16.0
